    <circle cx="250" cy="170" r="10" fill="#d9d3c8"/>
    <path d="M230 218 H270 L280 300 H220Z" fill="#e8a93b"/>
    <rect x="232" y="296" width="12" height="24" rx="5" fill="#3b2a1e"/><rect x="256" y="296" width="12" height="24" rx="5" fill="#3b2a1e"/>
    <path d="M232 230 L204 246" stroke="#f2c9a0" stroke-width="9" stroke-linecap="round"/>
