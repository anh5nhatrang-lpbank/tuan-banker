   <circle cx="400" cy="120" r="70" fill="url(#sun)"/>
   <path d="M0 300 Q130 250 260 285 T520 270 V380 H0Z" fill="#2f8a5a"/>
   <path d="M0 330 Q150 290 300 325 T520 315 V380 H0Z" fill="#256f48"/>
   <!-- nhà -->
   <rect x="300" y="190" width="150" height="100" rx="6" fill="#fff3dc"/>
   <path d="M285 195 L375 120 L465 195Z" fill="#c0562b"/>
   <rect x="352" y="225" width="46" height="65" rx="4" fill="#8a4a24"/>
   <rect x="315" y="212" width="28" height="28" rx="3" fill="#8fd0e0"/>
   <rect x="410" y="212" width="28" height="28" rx="3" fill="#8fd0e0"/>
