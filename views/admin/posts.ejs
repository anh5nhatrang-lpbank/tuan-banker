<%- include('_head') %>
<div class="admin-title"><h1>Bài viết</h1><a class="btn btn-primary" href="/admin/posts/new">+ Viết bài mới</a></div>
<div class="table-wrap"><table>
  <thead><tr><th>Tiêu đề</th><th>Chuyên mục</th><th>Trạng thái</th><th>Ngày</th><th></th></tr></thead>
  <tbody>
  <% posts.forEach(function (p) { %>
    <tr>
      <td><a href="/admin/posts/<%= p.id %>/edit"><%= p.title %></a></td>
      <td><%= cats[p.category] ? cats[p.category].short : '' %></td>
      <td><%= p.published ? 'Đã đăng' : 'Bản nháp' %></td>
      <td><%= fmtDate(p.createdAt) %></td>
      <td class="actions">
        <a class="btn btn-sm btn-ghost-dark" href="/admin/posts/<%= p.id %>/edit">Sửa</a>
        <form method="post" action="/admin/posts/<%= p.id %>/delete" data-confirm="Xóa bài viết này?"><button class="btn btn-sm btn-danger">Xóa</button></form>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table></div>
<%- include('_foot') %>
