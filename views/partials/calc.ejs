<section class="calc card" id="calc" aria-labelledby="calcTitle">
  <script type="application/json" id="loanRateData"><%- R.clientLoan() %></script>
  <h2 id="calcTitle">🧮 Máy tính khoản vay</h2>
  <p class="muted">Chọn mục đích vay và thời gian vay, lãi suất tự điền theo <a href="/lai-suat#lai-suat-vay">bảng lãi suất cho vay</a> (bạn vẫn có thể tự sửa). Kết quả chỉ mang tính tham khảo, lãi suất thực tế theo chính sách từng thời điểm.</p>
  <form id="calcForm" class="calc-grid" novalidate>
    <label>Mục đích vay
      <select id="cPurpose"></select>
    </label>
    <label>Số tiền vay (triệu đồng)
      <input type="number" id="cAmount" value="1500" min="1" step="10" inputmode="numeric">
    </label>
    <label>Lãi suất (%/năm)
      <input type="number" id="cRate" value="14.3" min="0" max="40" step="0.1" inputmode="decimal">
    </label>
    <label>Thời hạn (năm)
      <input type="number" id="cYears" value="20" min="1" max="40" step="1" inputmode="numeric">
    </label>
    <label>Phương thức trả
      <select id="cMethod">
        <option value="giam-dan">Gốc đều, lãi giảm dần</option>
        <option value="nien-kim">Niên kim (trả đều mỗi tháng)</option>
      </select>
    </label>
  </form>
  <div class="calc-result" aria-live="polite">
    <div><span>Trả tháng đầu</span><b id="rFirst">-</b></div>
    <div><span>Tổng lãi</span><b id="rInterest">-</b></div>
    <div><span>Tổng phải trả</span><b id="rTotal">-</b></div>
  </div>
</section>
