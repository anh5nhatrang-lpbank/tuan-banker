<section class="calc card" id="calc" aria-labelledby="calcTitle">
  <script type="application/json" id="loanRateData"><%- R.clientLoan(isAdmin) %></script>
  <h2 id="calcTitle">🧮 Máy tính khoản vay</h2>
  <p class="muted">Nhập số tiền, lãi suất dự kiến và thời gian vay để ước tính tiền trả hằng tháng. Muốn biết lãi suất vay hiện hành, hãy <a href="/lien-he">liên hệ</a> hoặc gọi <%= s.phone || '0905 491 125' %>. Kết quả chỉ mang tính tham khảo.</p>
  <form id="calcForm" class="calc-grid" novalidate>
    <label>Gói vay
      <select id="cPurpose"></select>
    </label>
    <label>Số tiền vay (triệu đồng)
      <input type="number" id="cAmount" value="1500" min="1" step="10" inputmode="numeric">
    </label>
    <label>Lãi suất (%/năm)
      <input type="number" id="cRate" value="12" min="0" max="40" step="0.1" inputmode="decimal">
    </label>
    <label>Thời hạn (năm)
      <input type="number" id="cYears" value="20" min="0.5" max="40" step="0.5" inputmode="numeric">
    </label>
    <label>Phương thức trả
      <select id="cMethod">
        <option value="giam-dan">Gốc đều, lãi giảm dần</option>
        <option value="nien-kim">Niên kim (trả đều mỗi tháng)</option>
      </select>
    </label>
  </form>
  <div class="calc-result" aria-live="polite">
    <div><span>Trả tháng đầu</span><b id="rFirst">-</b></div>
    <div><span>Tổng lãi</span><b id="rInterest">-</b></div>
    <div><span>Tổng phải trả</span><b id="rTotal">-</b></div>
  </div>
</section>
