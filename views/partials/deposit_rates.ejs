<%# Bảng lãi suất huy động có kỳ hạn: dữ liệu từ lib/rates.js (cùng nguồn với máy tính tiền gửi) %>
<% var D = R.DEPOSIT; var maxV = 0; D.rows.forEach(function (r) { r.slice(1).forEach(function (v) { if (v != null && v > maxV) maxV = v; }); }); %>
<section class="rates-block" id="tiet-kiem">
  <div class="rates-head">
    <div>
      <h2>💰 Lãi suất tiết kiệm LPBank</h2>
      <p class="muted">Tiết kiệm có kỳ hạn · Gửi tại quầy · Tiền Việt Nam đồng (VND) · Hiệu lực từ <b><%= D.date %></b> · Đơn vị: %/năm</p>
    </div>
  </div>

  <div class="rate-stats">
    <% R.depositHighlights().forEach(function (h) { %>
      <div class="rate-stat"><b><%= R.pct(h.value) %></b><span><%= h.title %></span><small><%= h.sub %></small></div>
    <% }) %>
  </div>

  <div class="vip-note">
    <b>⭐ Khách hàng Ưu tiên hoặc gửi mới tại LPBank Diên Khánh</b> sẽ được áp dụng mức lãi suất ưu đãi rất tốt, cao hơn biểu niêm yết bên dưới.
    Quý khách vui lòng <a href="/lien-he">liên hệ</a><% if (s.phone) { %> hoặc gọi <a href="tel:<%= s.phone.replace(/\s/g, '') %>"><b><%= s.phone %></b></a><% } %> để được tư vấn mức lãi suất cụ thể.
  </div>

  <div class="rate-table-wrap">
    <table class="rate-table">
      <thead>
        <tr>
          <th rowspan="2">Kỳ hạn</th>
          <th rowspan="2">Lãi cuối kỳ</th>
          <th colspan="2">Lĩnh lãi định kỳ</th>
          <th rowspan="2">Lãi trả trước</th>
          <th rowspan="2">Rút 1 lần<small>(chuyển đổi từ rút gốc linh hoạt)</small></th>
        </tr>
        <tr><th>Hàng tháng</th><th>Hàng quý</th></tr>
      </thead>
      <tbody>
        <% D.rows.forEach(function (r) { %>
        <tr>
          <th scope="row"><%= r[0] %> tháng</th>
          <% r.slice(1).forEach(function (v) { %><td class="<%= v === maxV ? 'best' : '' %>"><%= R.pct(v) %></td><% }) %>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <p class="muted rates-foot">Ô nền vàng là mức cao nhất trong bảng. Dấu "–" nghĩa là kỳ hạn đó không có hình thức lĩnh lãi này. Biểu lãi suất niêm yết của LPBank (lpbank.com.vn/ca-nhan/lai-suat), đối chiếu ngày <%= D.checked %>; lãi suất mang tính tham khảo và có thể thay đổi theo từng thời điểm, vui lòng liên hệ để được báo mức lãi suất và điều kiện áp dụng khi gửi.</p>
</section>
