<%# Khung liên hệ thay cho bảng lãi suất (khách truy cập không xem được số liệu) %>
<section class="rates-block" id="<%= id %>">
  <div class="rates-head"><div>
    <h2><%= title %></h2>
    <p class="muted">Lãi suất thay đổi theo từng thời kỳ, kỳ hạn và nhóm khách hàng. Vui lòng liên hệ để được báo mức lãi suất mới nhất.</p>
  </div></div>
  <div class="card"><div class="card-body">
    <p>Gọi hoặc nhắn Zalo <b><%= s.phone || '0905 491 125' %></b>, tôi sẽ báo lãi suất hiện hành và tư vấn phương án phù hợp, hoàn toàn miễn phí.</p>
    <p>
      <a class="btn btn-gold" href="tel:<%= (s.phone || '0905491125').replace(/\s/g, '') %>">📞 Gọi <%= s.phone || '0905 491 125' %></a>
      <a class="btn btn-ghost" href="/lien-he">Để lại thông tin nhận tư vấn</a>
    </p>
  </div></div>
</section>
