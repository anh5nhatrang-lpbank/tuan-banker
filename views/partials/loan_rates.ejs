<%# Bảng lãi suất cho vay: mỗi mục đích × thời hạn chỉ có MỘT mức lãi suất (đã cộng sẵn). Dữ liệu từ lib/rates.js %>
<% if (isAdmin && !R.hasLoan()) { %>
<section class="rates-block admin-only"><div class="admin-lock">🔒 Chưa có bảng lãi suất thông thường. <a href="/admin/loan-rates">Nhập tại Quản trị → Lãi suất vay</a> (dữ liệu lưu riêng trên máy chủ, không nằm trong mã nguồn).</div></section>
<% } else if (isAdmin) { var LT = R.loanTable(); var span = (LT.max - LT.min) || 1; %>
<section class="rates-block admin-only" id="lai-suat-thong-thuong">
  <div class="admin-lock">🔒 Chỉ admin nhìn thấy mục này. Khách truy cập chỉ thấy bảng lãi suất ưu đãi.</div>
  <div class="rates-head">
    <div>
      <h2>🏦 Lãi suất cho vay thông thường (áp dụng từ <%= R.LOAN.date %>)</h2>
      <p class="muted">Khách hàng cá nhân · Vay bằng VND · Mức thông thường trong quá trình vay, khi không có ưu đãi · Đơn vị: %/năm, tính trên dư nợ gốc thực tế</p>
    </div>
  </div>

  <div class="rate-stats">
    <% ['nha-dat', 'tieu-dung', 'sxkd'].forEach(function (k) { var row = LT.rows.filter(function (x) { return x.key === k; })[0]; %>
      <div class="rate-stat"><small>Lãi suất từ</small><b><%= R.pct(row.min, 1) %></b><span><%= row.icon %> <%= row.name %></span></div>
    <% }) %>
  </div>

  <div class="rate-table-wrap">
    <table class="rate-table loan-rate-table">
      <thead>
        <tr>
          <th>Mục đích vay</th>
          <% R.LOAN.brackets.forEach(function (b) { %><th><%= b.label %><% if (b.sub) { %><small><%= b.sub %></small><% } %></th><% }) %>
        </tr>
      </thead>
      <tbody>
        <% LT.rows.forEach(function (row) { %>
        <tr id="vay-<%= row.key %>">
          <th scope="row"><div class="rt-name"><span class="rt-icon"><%= row.icon %></span><span><b><%= row.name %></b><small><%= row.note %></small></span></div></th>
          <% row.rates.forEach(function (v) { %>
            <td class="heat h<%= Math.round(((v - LT.min) / span) * 9) %>"><%= R.pct(v, 1) %></td>
          <% }) %>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <p class="rate-legend"><span class="lg lg-lo"></span> Lãi suất thấp <span class="lg lg-hi"></span> Lãi suất cao hơn</p>

  <div class="rate-notes">
    <h3>Cách đọc bảng</h3>
    <ul class="check">
      <li>Chọn dòng theo <b>mục đích vay</b>, chọn cột theo <b>thời gian vay</b>, ô giao nhau là lãi suất/năm. Không cần cộng thêm khoản nào khác.</li>
      <li>Đây là mức lãi suất <b>từ</b> (thấp nhất) dành cho khách hàng thông thường. Mức cụ thể do LPBank quyết định theo hồ sơ, tài sản bảo đảm và xếp hạng tín dụng của từng khách hàng.</li>
      <li>Lãi suất được điều chỉnh định kỳ 3 tháng một lần; công thức và mức lãi suất cụ thể được ghi trong hợp đồng tín dụng khi ký kết.</li>
      <li><b>Vay cầm cố sổ tiết kiệm/giấy tờ có giá do LPBank phát hành:</b> lãi suất cố định, tối thiểu bằng lãi suất tiết kiệm cùng kỳ hạn cộng 2%/năm (vay từ 1 tháng). Liên hệ để được báo mức cụ thể.</li>
    </ul>
    <p class="muted rates-foot">Bảng chỉ mang tính tham khảo, có thể thay đổi theo từng thời kỳ. Phí trả nợ trước hạn theo biểu phí hiện hành của LPBank. Vui lòng liên hệ để được tư vấn mức lãi suất và điều kiện vay áp dụng cho hồ sơ của bạn.</p>
    <p><a class="btn btn-gold" href="/san-pham-vay#dang-ky">Để lại thông tin nhận tư vấn lãi suất vay</a></p>
  </div>
</section>
<% } %>
