<%- include('partials/head') %>
<section class="page-head"><div class="container">
  <p class="eyebrow">🏦 Khay sản phẩm</p>
  <h1>Sản phẩm vay bán lẻ LPBank</h1>
  <p class="lead">Vay mua nhà, mua xe, tiêu dùng, kinh doanh. Điều kiện, giấy tờ, thời hạn vay được tóm tắt dưới đây. Bảng lãi suất cho vay hiện hành được công bố ngay bên dưới, mỗi loại vay chỉ có một mức lãi suất, dễ xem và dễ so sánh.</p>
  <p>
    <a class="btn btn-gold" href="#dang-ky">Để lại thông tin nhận tư vấn</a>
    <% if (s.phone) { %><a class="btn btn-ghost" href="tel:<%= s.phone.replace(/\s/g, '') %>">📞 Gọi <%= s.phone %></a><% } %>
  </p>
</div></section>

<section class="section"><div class="container">
  <%- include('partials/loan_promo') %>
  <%- include('partials/loan_rates') %>
  <div class="mt-2 card loan-common"><div class="card-body">
    <h2>Điều kiện chung và giấy tờ cần chuẩn bị</h2>
    <div class="two-col-simple">
      <div>
        <h3>Ai có thể vay?</h3>
        <ul class="check"><% common.who.forEach(function (t) { %><li><%= t %></li><% }) %></ul>
      </div>
      <div>
        <h3>Giấy tờ thường cần</h3>
        <ul class="check"><% common.docs.forEach(function (t) { %><li><%= t %></li><% }) %></ul>
      </div>
    </div>
    <p class="muted"><small>Danh mục hồ sơ cụ thể có thể thay đổi tùy sản phẩm và từng trường hợp. Cán bộ tư vấn sẽ hướng dẫn chi tiết khi liên hệ.</small></p>
  </div></div>

  <div class="loan-grid">
    <% loans.forEach(function (l) { %>
    <article class="card loan-card" id="<%= l.key %>"><div class="card-body">
      <span class="tag"><%= l.tag %></span>
      <h2><%= l.icon %> <%= l.name %></h2>
      <p><%= l.summary %></p>
      <h4>Mục đích vay</h4>
      <ul class="check"><% l.purposes.forEach(function (t) { %><li><%= t %></li><% }) %></ul>
      <ul class="facts">
        <li><span>Thời gian vay</span><b><%= l.term %></b></li>
        <li><span>Hạn mức vay</span><b><%= l.limit %></b></li>
        <li><span>Tài sản bảo đảm</span><b><%= l.collateral %></b></li>
        <% var pm = R.promoMin(l.key); %>
        <li><span>Lãi suất ưu đãi</span><% if (pm) { %><b>Từ <%= R.pct(pm, 2) %>/năm <a href="#lai-suat-vay">(xem bảng)</a></b><% } else { %><b>Liên hệ<% if (s.phone) { %>: <a href="tel:<%= s.phone.replace(/\s/g, '') %>"><%= s.phone %></a><% } %></b><% } %></li>
      </ul>
      <h4>Hồ sơ cần chuẩn bị</h4>
      <ul class="check"><% l.docs.forEach(function (t) { %><li><%= t %></li><% }) %></ul>
      <a class="btn btn-gold block" href="/san-pham-vay?sp=<%= l.key %>#dang-ky">Đăng ký tư vấn sản phẩm này</a>
    </div></article>
    <% }) %>
  </div>

  <div class="mt-2 card" id="dang-ky"><div class="card-body">
    <h2>Để lại thông tin, tôi sẽ liên hệ tư vấn</h2>
    <p class="muted">Miễn phí, không ràng buộc. Tôi sẽ gọi lại báo lãi suất, hướng dẫn hồ sơ và phương án phù hợp.</p>
    <form class="form" method="post" action="/san-pham-vay">
      <div class="row">
        <label>Họ và tên<input name="name" maxlength="60" required></label>
        <label>Số điện thoại<input name="phone" type="tel" maxlength="20" required inputmode="tel"></label>
      </div>
      <div class="row">
        <label>Dịch vụ quan tâm
          <select name="product"><% loans.forEach(function (l) { %><option value="<%= l.key %>" <%= sel === l.key ? 'selected' : '' %>><%= l.name %></option><% }) %><option value="khac">Chưa rõ, cần tư vấn</option></select>
        </label>
        <label>Khu vực (phường/xã)<input name="area" maxlength="80" placeholder="Ví dụ: Nha Trang, Diên Khánh"></label>
      </div>
      <div class="row">
        <label>Số tiền cần vay
          <select name="amount"><option value="">- Chọn -</option><% ['Dưới 500 triệu','500 triệu - 1 tỷ','1 - 2 tỷ','2 - 5 tỷ','Trên 5 tỷ'].forEach(function (t) { %><option><%= t %></option><% }) %></select>
        </label>
        <label>Thời gian vay dự kiến<input name="term" maxlength="40" placeholder="Ví dụ: 15 năm"></label>
      </div>
      <div class="row">
        <label>Thu nhập hàng tháng
          <select name="income"><option value="">- Chọn -</option><% ['Dưới 10 triệu','10 - 20 triệu','20 - 50 triệu','Trên 50 triệu'].forEach(function (t) { %><option><%= t %></option><% }) %></select>
        </label>
        <label>Hình thức nhận thu nhập
          <select name="incomeType"><option value="">- Chọn -</option><option>Chuyển khoản</option><option>Tiền mặt / Tự doanh</option></select>
        </label>
        <label>Giờ tiện liên lạc
          <select name="contactTime"><option value="">- Chọn -</option><% ['Sáng (8h00 - 12h00)','Chiều (13h30 - 17h00)','Tối (sau 18h00)','Bất cứ lúc nào'].forEach(function (t) { %><option><%= t %></option><% }) %></select>
        </label>
      </div>
      <label>Ghi chú thêm (tài sản bảo đảm, nguồn thu nhập...)<textarea name="note" rows="3" maxlength="800"></textarea></label>
      <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
      <button class="btn btn-primary">Gửi thông tin</button>
    </form>
  </div></div>
</div></section>
<%- include('partials/foot') %>
